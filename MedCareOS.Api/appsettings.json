{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Ingresa-tu-cadena-en-User-Secrets"
  },
  "Supabase": {
    "ProjectId": "Ingresa-tu-project-id-en-User-Secrets"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest",
    "RedeliveryMode": "QuartzInMemory"
  },
  "Scoring": {
    "PublishAnomalyOnCreate": false
  },
  "ScoringRetry": {
    "PollIntervalSeconds": 60,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "PendingStaleMinutes": 5,
    "BaseBackoffMinutes": 2,
    "MaxBackoffMinutes": 60,
    "LeaseMinutes": 5
  },
  "AiService": {
    "TimeoutSeconds": 30
  },
  "Omro": {
    "TenantId": "11111111-1111-1111-1111-111111111111"
  },
  "OmroAuth": {
    "Issuer": "omro-orchestrator",
    "Audience": "medcareos-api",
    "Role": "omro_service"
  },
  "Notifications": {
    "ClinicName": "Clínica MedCare",
    "TimeZoneId": "America/Santiago",
    "PublicBaseUrl": "https://app.medcare.cl",
    "ActionTokenDefaultTtlHours": 48,
    "MaxPrimaryChannelAttempts": 3,
    "IncludeSpecialtyInMessages": true,
    "SensitiveSpecialtiesExcluded": [],
    "ContentRetentionDays": 30,
    "RetentionPollIntervalMinutes": 60,
    "RetentionBatchSize": 100,
    "EmailProvider": "Fake",
    "WhatsAppProvider": "Fake",
    "Resend": {
      "BaseUrl": "https://api.resend.com/",
      "FromAddress": "notificaciones@medcare.cl",
      "FromName": "Clínica MedCare",
      "TimeoutSeconds": 15
    },
    "RateLimiting": {
      "ProviderWebhooksPermitLimit": 120,
      "ProviderWebhooksWindowSeconds": 60,
      "PublicActionsPermitLimit": 15,
      "PublicActionsWindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
